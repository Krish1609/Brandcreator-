# ===================================================
# BrandCreator - Root .gitignore
# ===================================================

# 1. Environment Secrets & Credentials (CRITICAL SECURITY)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
*.env.*
!.env.example
!*.env.example

# 2. Dependencies
node_modules/
*/node_modules/
.pnp
.pnp.js

# 3. Next.js & Build Artifacts
.next/
*/.next/
out/
build/
dist/
.vercel

# 4. Uploads & Generated User Media
backend/uploads/*
!backend/uploads/.gitkeep
!backend/uploads/content/
backend/uploads/content/*
!backend/uploads/content/.gitkeep

# 5. Logs & Debugging
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/

# 6. Operating System & Editor Files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo

# 7. Temporary / Scratch files
scratch/
.system_generated/
